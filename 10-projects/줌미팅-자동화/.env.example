# 줌 미팅 생성 자격증명 (zoom_meeting.py 용)
# 발급: marketplace.zoom.us > Developer > Build App > Server-to-Server OAuth
# 이 파일을 이 폴더에 두지 말고, 워크스페이스 루트로 복사해 .env 로 저장할 것
# (워크스페이스 루트/.env, git 제외됨 — 두 PC 동기화 환경이라 credential 설정을 처음부터 다시 할 일이 생김)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# 줌 로그인 이메일 (S2S OAuth는 'me' 축약 불가, 실제 유저ID 필요)
ZOOM_USER_EMAIL=
