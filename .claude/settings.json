{
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git rev-list:*)",
      "Bash(git config:*)",
      "PowerShell(git status:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git rev-list:*)",
      "PowerShell(git config:*)",
      "PowerShell(./sync.ps1:*)",
      "PowerShell(.\\sync.ps1:*)",
      "Bash(.venv/bin/python3 .claude/skills/bulsaja-option-cleanup/scripts/run_options.py:*)",
      "Bash(.venv/bin/python3 .claude/skills/bulsaja-category-fix/scripts/category_gate.py:*)",
      "Bash(.venv/bin/python3 .claude/skills/bulsaja-category-fix/scripts/run_all.py:*)",
      "Bash(.venv/bin/python3 .claude/skills/product-name/scripts/run_names.py:*)",
      "Bash(.venv/bin/python3 .claude/skills/bulsaja-thumbnail/scripts/run_thumbs.py:*)",
      "mcp__bulsaja__bulsaja_market_delete",
      "Bash(PYTHONPATH=.claude/lib .venv/bin/python3 .claude/skills/bulsaja-category-fix/scripts/category_gate.py:*)"
    ],
    "deny": [
      "Edit(00-system/판매금지-기준/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/00-system/scripts/sync_banned_rules.py\" --quiet",
            "timeout": 45,
            "statusMessage": "판매금지 기준 확인 중"
          }
        ]
      }
    ]
  }
}
