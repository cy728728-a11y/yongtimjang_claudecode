<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  sold-lock 매일 00:01 실행 템플릿. __WORKSPACE__ / __HOME__ 은 SKILL.md 설치 명령의 sed 가 치환한다.
  launchd 는 ~ 를 펴지 않으므로 반드시 절대경로로 치환된 사본을 ~/Library/LaunchAgents/ 에 둔다.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eroom.sold-lock</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>__WORKSPACE__/.venv/bin/python3</string>
    <string>__WORKSPACE__/.claude/skills/sold-lock/scripts/run_sold_lock.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__WORKSPACE__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>0</integer>
    <key>Minute</key>
    <integer>1</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__HOME__/python_work/data/sold-lock/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/python_work/data/sold-lock/logs/launchd.err.log</string>
</dict>
</plist>
