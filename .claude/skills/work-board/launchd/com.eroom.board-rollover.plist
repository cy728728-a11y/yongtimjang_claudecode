<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 업무판 rollover. __WORKSPACE__ / __HOME__ 은 SKILL.md 설치 명령의 sed 가 치환한다. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.eroom.board-rollover</string>
  <key>ProgramArguments</key>
  <array>
    <string>__WORKSPACE__/.venv/bin/python3</string>
    <string>__WORKSPACE__/.claude/skills/work-board/scripts/board_sync.py</string>
    <string>rollover</string>
  </array>
  <key>WorkingDirectory</key><string>__WORKSPACE__</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__HOME__/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/python_work/data/work-board/logs/board-rollover.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/python_work/data/work-board/logs/board-rollover.err.log</string>
</dict>
</plist>
